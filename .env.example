# Copy to .env (never commit .env). Every value is optional: the app runs fully
# without any API key using its deterministic rule-based assistant.

# --- GenAI provider -------------------------------------------------------
# auto = use Gemini if GEMINI_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set, else rules only.
LLM_PROVIDER=auto
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Paid key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_TIMEOUT_MS=20000

# --- Server ------------------------------------------------------------------
PORT=8080
LOG_LEVEL=info
# Number of trusted reverse proxies in front of the app (Cloud Run = 1).
TRUST_PROXY_HOPS=0
UPSTREAM_TIMEOUT_MS=6000
RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT_PER_MINUTE=10
